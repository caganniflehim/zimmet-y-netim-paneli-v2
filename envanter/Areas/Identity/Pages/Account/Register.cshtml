@page
@model RegisterModel
@{
    ViewData["Title"] = "Kayıt Ol";
}

<h1>@ViewData["Title"]</h1>

<div class="row">
    <div class="col-md-4">
        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
            <h2>Yeni bir hesap oluşturun.</h2>
            <hr />
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

            <div class="form-floating mb-3">
                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                <label asp-for="Input.Email">E-posta</label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <!-- Şifre Alanı ve Göster/Gizle Butonu -->
            <div class="form-floating mb-3 position-relative">
                <input asp-for="Input.Password" class="form-control" id="passwordInput" autocomplete="new-password" aria-required="true" placeholder="password" />
                <label asp-for="Input.Password">Şifre</label>
                <button type="button" class="btn btn-outline-secondary position-absolute end-0 top-0 mt-2 me-2" onclick="togglePassword('passwordInput', this)" style="z-index: 10;">Göster</button>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <!-- Şifre Tekrar Alanı ve Göster/Gizle Butonu -->
            <div class="form-floating mb-3 position-relative">
                <input asp-for="Input.ConfirmPassword" class="form-control" id="confirmPasswordInput" autocomplete="new-password" aria-required="true" placeholder="password" />
                <label asp-for="Input.ConfirmPassword">Şifre Tekrar</label>
                <button type="button" class="btn btn-outline-secondary position-absolute end-0 top-0 mt-2 me-2" onclick="togglePassword('confirmPasswordInput', this)" style="z-index: 10;">Göster</button>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>

            <button id="registerSubmit" type="submit" class="w-100 btn btn-lg btn-primary">Kayıt Ol</button>
        </form>
    </div>
</div>

<!-- Şifreyi gösterip gizleyen küçük JavaScript fonksiyonu -->
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function togglePassword(fieldId, btn) {
            const input = document.getElementById(fieldId);
            if (input.type === "password") {
                input.type = "text";
                btn.textContent = "Gizle";
            } else {
                input.type = "password";
                btn.textContent = "Göster";
            }
        }
    </script>
}