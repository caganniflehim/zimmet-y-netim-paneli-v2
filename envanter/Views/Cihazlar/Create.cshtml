@model envanter.Models.Cihazlar

<h1>Yeni Cihaz Ekle</h1>

<form asp-action="Create" method="post">
    <!-- Diğer alanlar ile birlikte Tarihi de ekle -->
    <div class="form-group">
        <label>Marka Model</label>
        <input name="MarkaModel" class="form-control" />
    </div>
    
    <div class="form-group">
        <label>Seri No</label>
        <input name="SeriNo" class="form-control" />
    </div>

    <div class="form-group">
        <label>Kategori</label>
        <input name="Kategori" class="form-control" />
    </div>

    <div class="form-group">
        <label>Alış Tarihi</label>
        <input type="date" name="AlisTarihi" class="form-control" />
    </div>

    <div class="form-group">
        <label>Durum</label>
        <input name="Durum" class="form-control" />
    </div>

    <br />
    <button type="submit" class="btn btn-primary">Kaydet</button>
</form>